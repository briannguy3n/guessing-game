# A group of players. Copy to .env.<group>, e.g. .env.chimgee.
#
# The file name is the group name: .env.chimgee is played with
# ./guess "cats" --group chimgee
#
# These files are committed on purpose — they hold names and emails, no
# secrets. Keep the repo private.
#
# Number players from 1 upwards with no gaps.

PLAYER_1_NAME=
PLAYER_1_EMAIL=

PLAYER_2_NAME=
PLAYER_2_EMAIL=
