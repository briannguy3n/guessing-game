# A group of players. Copy to .env.<group>, e.g. .env.chimgee or .env.friends.
#
# The file name is the group name. It also becomes the email tag you send to:
# .env.chimgee is played by emailing you+chimgee@gmail.com.
#
# These files are committed — they hold names and emails, no secrets, and the
# scheduled job needs them. Keep the repo private.
#
# Number players from 1 upwards with no gaps. Two is the classic game; more
# works too, and then everyone sees every character except their own.

PLAYER_1_NAME=Brian
PLAYER_1_EMAIL=nguyenbrian604@gmail.com

PLAYER_2_NAME=John
PLAYER_2_EMAIL=john_chiou@outlook.com

PLAYER_3_NAME=Oscar
