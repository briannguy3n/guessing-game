# Copy to .env and fill in. .env is gitignored — it holds the only secrets.
# Players live in per-group files instead: see .env.group.example.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The mailbox rounds are sent from, and the one the listener watches.
# Gmail: use an App Password, not your account password.
# https://myaccount.google.com/apppasswords (requires 2FA on)
SMTP_USER=
SMTP_PASSWORD=

# Defaults below work for Gmail; change only if you use another provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com

# Most rounds one group can start in a day. Stops a stuck sender or a mail
# loop from burning API credit.
DAILY_ROUND_LIMIT=10

# FROM_ADDRESS=
# MODEL=claude-opus-5
